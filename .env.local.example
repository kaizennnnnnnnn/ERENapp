# ─── Supabase ───────────────────────────────────────────────────────────────
# Get these from: https://app.supabase.com → your project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ─── Anthropic (Eren's voice on /talk) ───────────────────────────────────────
# https://console.anthropic.com → API keys.
# Server-side only — never prefix this with NEXT_PUBLIC_, or the key ships to
# the browser and anyone can spend it. /api/chat is the only thing that reads it.
ANTHROPIC_API_KEY=sk-ant-...

# ─── Supabase service role (server-only) ─────────────────────────────────────
# Settings → API → service_role. Bypasses RLS, so it must NEVER be prefixed
# with NEXT_PUBLIC_. Read only by src/lib/supabase/admin.ts, which is imported
# only from app/api routes. Without it every /api/notify-* route and /api/decay
# fails at runtime.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─── Web push (VAPID) ────────────────────────────────────────────────────────
# Generate once with:  npx web-push generate-vapid-keys
# Without BOTH of these, serverPush.ts silently skips setVapidDetails and every
# push in the app fails while still reporting success — no error, no delivery.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key-here
VAPID_PRIVATE_KEY=your-vapid-private-key-here

# ─── Cron shared secret ──────────────────────────────────────────────────────
# Any long random string. The pg_cron jobs send it as x-cron-secret; the
# /api/notify-* and /api/decay routes reject requests without it, so a stranger
# who learns a household UUID can't push arbitrary text to the couple's phones.
# Must match the value baked into the cron job definitions in Supabase.
CRON_SECRET=any-long-random-string

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
